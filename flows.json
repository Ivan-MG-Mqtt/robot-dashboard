    {
        "id": "6d80783eee9e9ef7",
        "type": "function",
        "z": "92f5828543a6bb46",
        "name": "ProcesarPosicion",
        "func": "let txt = msg.payload;\n\nif (txt.startsWith(\"A,\")) {\n\n    let p = txt.split(\",\");\n\n    msg.tipo = \"A\";\n\n    msg.payload =\n        \"A: \" + p[1] +\n        \"° | B: \" + p[2] + \"°\";\n\n    return msg;\n}\n\nif (txt.startsWith(\"XY,\")) {\n\n    let p = txt.split(\",\");\n\n    msg.tipo = \"XY\";\n\n    msg.payload =\n        \"X: \" + p[1] +\n        \" | Y: \" + p[2];\n\n    return msg;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 170,
        "y": 340,
        "wires": [
            [
                "19efc34cd93b2105"
            ]
        ]
    },
    {
        "id": "39d1e8c1f420b461",
        "type": "ui_template",
        "z": "92f5828543a6bb46",
        "group": "09d9858fd1fb461e",
        "name": "",
        "order": 0,
        "width": "12",
        "height": "10",
        "format": "<div style=\"width:100%; height:500px; background:#111; position:relative; overflow:hidden;\">\n\n    <canvas id=\"robotCanvas\" width=\"600\" height=\"500\"></canvas>\n\n</div>\n\n<script>\n    (function(scope){\n\n    const canvas =\n        document.getElementById('robotCanvas');\n\n    const ctx =\n        canvas.getContext('2d');\n\n    let angA = 0;\n    let angB = 0;\n\n    const L1 = 150;\n    const L2 = 100;\n\n    function dibujar(){\n\n        ctx.clearRect(\n            0,\n            0,\n            canvas.width,\n            canvas.height\n        );\n\n        // Fondo\n\n        ctx.fillStyle = \"#111\";\n\n        ctx.fillRect(\n            0,\n            0,\n            canvas.width,\n            canvas.height\n        );\n\n        // Centro\n\n        const cx = 300;\n        const cy = 250;\n\n        // Convertir grados a radianes\n\n        let t1 =\n            angA * Math.PI / 180;\n\n        let t2 =\n            (angA + angB) *\n            Math.PI / 180;\n\n        // Punto brazo 1\n\n        let x1 =\n            cx + L1 * Math.cos(t1);\n\n        let y1 =\n            cy - L1 * Math.sin(t1);\n\n        // Punto final\n\n        let x2 =\n            x1 + L2 * Math.cos(t2);\n\n        let y2 =\n            y1 - L2 * Math.sin(t2);\n\n        // Base\n\n        ctx.beginPath();\n\n        ctx.arc(\n            cx,\n            cy,\n            10,\n            0,\n            Math.PI * 2\n        );\n\n        ctx.fillStyle = \"white\";\n\n        ctx.fill();\n\n        // Brazo 1\n\n        ctx.beginPath();\n\n        ctx.moveTo(cx, cy);\n\n        ctx.lineTo(x1, y1);\n\n        ctx.lineWidth = 10;\n\n        ctx.strokeStyle = \"cyan\";\n\n        ctx.stroke();\n\n        // Brazo 2\n\n        ctx.beginPath();\n\n        ctx.moveTo(x1, y1);\n\n        ctx.lineTo(x2, y2);\n\n        ctx.lineWidth = 10;\n\n        ctx.strokeStyle = \"lime\";\n\n        ctx.stroke();\n\n        // Punta\n\n        ctx.beginPath();\n\n        ctx.arc(\n            x2,\n            y2,\n            8,\n            0,\n            Math.PI * 2\n        );\n\n        ctx.fillStyle = \"red\";\n\n        ctx.fill();\n\n        // Texto\n\n        ctx.fillStyle = \"white\";\n\n        ctx.font = \"18px Arial\";\n\n        ctx.fillText(\n            \"A: \" + angA.toFixed(1),\n            20,\n            30\n        );\n\n        ctx.fillText(\n            \"B: \" + angB.toFixed(1),\n            20,\n            60\n        );\n    }\n\n    scope.$watch(\n        'msg',\n        function(msg){\n\n            if(!msg) return;\n\n            if(\n                msg.payload &&\n                msg.payload.a !== undefined\n            ){\n\n                angA =\n                    parseFloat(\n                        msg.payload.a\n                    );\n\n                angB =\n                    parseFloat(\n                        msg.payload.b\n                    );\n\n                dibujar();\n            }\n        }\n    );\n\n    dibujar();\n\n})(scope);\n\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 200,
        "y": 560,
        "wires": [
            []
        ]
    },
